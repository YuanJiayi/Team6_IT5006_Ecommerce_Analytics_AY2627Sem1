{
  "fitted_on": "75039 primary training orders (outcomes recorded before the test cutoff)",
  "verified_against": "data/outputs/phase2/eta/test_metrics.csv and data/outputs/phase2/handover/test_scores.csv",
  "scikit_learn": "1.9.1",
  "random_state": 42,
  "models": {
    "checkout": {
      "file": "phase2_final_checkout_delivery_days_ridge.joblib",
      "candidate": "ridge_100",
      "output": "predicted purchase-to-delivery days",
      "numeric_inputs": [
        "promised_days",
        "promise_slack",
        "route_typical_days",
        "seller_ship_days",
        "distance_km",
        "same_state",
        "purchase_hour",
        "n_items",
        "n_products",
        "n_sellers",
        "total_price",
        "total_freight",
        "total_weight_g",
        "total_volume_cm3",
        "max_installments"
      ],
      "categorical_inputs": [
        "customer_state",
        "seller_state",
        "product_category",
        "payment_type",
        "purchase_dayofweek"
      ]
    },
    "handover": {
      "file": "phase2_final_handover_delivery_days_ridge.joblib",
      "candidate": "ridge_100",
      "output": "predicted purchase-to-delivery days",
      "numeric_inputs": [
        "promised_days",
        "promise_slack",
        "route_typical_days",
        "seller_ship_days",
        "distance_km",
        "same_state",
        "purchase_hour",
        "n_items",
        "n_products",
        "n_sellers",
        "total_price",
        "total_freight",
        "total_weight_g",
        "total_volume_cm3",
        "max_installments",
        "approval_days",
        "handover_days",
        "route_transit_90d_at_handover"
      ],
      "categorical_inputs": [
        "customer_state",
        "seller_state",
        "product_category",
        "payment_type",
        "purchase_dayofweek"
      ]
    },
    "late_warning": {
      "file": "phase2_final_late_warning_logistic.joblib",
      "candidate": "logistic_c0.01",
      "output": "probability of arriving after the promised calendar date (predict_proba[:, 1])",
      "numeric_inputs": [
        "promised_days",
        "promise_slack",
        "route_typical_days",
        "seller_ship_days",
        "distance_km",
        "same_state",
        "purchase_hour",
        "n_items",
        "n_products",
        "n_sellers",
        "total_price",
        "total_freight",
        "total_weight_g",
        "total_volume_cm3",
        "max_installments",
        "approval_days",
        "handover_days",
        "route_transit_90d_at_handover",
        "remaining_slack",
        "past_promise_at_handover",
        "slack_shortfall",
        "state_backlog_recent_vs_8wk"
      ],
      "categorical_inputs": [
        "customer_state",
        "seller_state",
        "product_category",
        "payment_type",
        "purchase_dayofweek"
      ]
    }
  }
}
