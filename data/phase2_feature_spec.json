{
  "numeric_features": [
    "promised_days",
    "distance_km",
    "same_state",
    "purchase_hour",
    "n_items",
    "n_products",
    "n_sellers",
    "total_price",
    "total_freight",
    "total_weight_g",
    "total_volume_cm3",
    "max_installments"
  ],
  "categorical_features": [
    "customer_state",
    "seller_state",
    "product_category",
    "payment_type",
    "purchase_dayofweek",
    "purchase_month"
  ],
  "classification_target": "is_late",
  "regression_target": "delivery_days",
  "random_state": 42,
  "split": "time-based: most recent 20% of orders by purchase time are the test set",
  "test_cutoff": "2018-05-26 18:18:03",
  "cv": "expanding window: fold k trains on time_block < k and validates on time_block == k",
  "n_folds": 5
}